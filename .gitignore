
# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================
.env
.env.*
!.env.example
**/application-local.properties
**/application-secret.properties
**/secrets/
**/*credentials*
**/*secret*

# ==========================================
# FRONTEND - NODE / REACT
# ==========================================
**/node_modules/
**/dist/
**/build/
**/.vite/
**/coverage/
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
**/.eslintcache

# ==========================================
# BACKEND - JAVA / MAVEN / SPRING BOOT
# ==========================================
**/target/
**/*.class
**/*.jar
**/*.war
**/*.ear
**/hs_err_pid*
**/replay_pid*

# Maven wrapper JAR is intentionally retained
!**/.mvn/wrapper/maven-wrapper.jar


# Keep backup documentation and directory placeholder
!db_backup/README.md
!db_backup/.gitkeep

# ==========================================
# IDE - ECLIPSE / INTELLIJ / VS CODE
# ==========================================
**/.metadata/
**/.settings/
**/.classpath
**/.project
**/.factorypath
**/.recommenders/
**/.idea/
**/*.iml
**/.vscode/

# ==========================================
# OPERATING SYSTEM
# ==========================================
.DS_Store
Thumbs.db
Desktop.ini

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ==========================================
# TEST & GENERATED REPORTS
# ==========================================
**/surefire-reports/
**/failsafe-reports/
**/test-output/
